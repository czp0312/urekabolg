---
import { getCollection, render } from 'astro:content'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import TagPills from '../../components/TagPills.astro'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(p => import.meta.env.DEV || !p.data.draft)
  return posts.map(p => ({ params: { slug: p.id } }))
}

const { slug } = Astro.params
const posts = (await getCollection('blog')).filter(p => import.meta.env.DEV || !p.data.draft)
const post = posts.find(p => p.id === slug)

if (!post)
  return new Response('Not found', { status: 404 })

const { Content, headings } = await render(post)
const sections = headings
---

<Layout title={`${post.data.title} — Ureka Blog`} description={post.data.description} type="article" publishedTime={post.data.date}>
  <Header />
  <main class="max-w-3xl mx-auto px-4 pt-20 pb-16">
    <a href="/#posts" class="inline-flex items-center text-xs font-mono text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] transition-colors mb-8">
      <span data-lang="zh">← 返回写作</span>
      <span data-lang="en">← Back to writing</span>
    </a>
    <h1 class="text-lg font-medium mb-2">
      <span data-lang="zh">{post.data.title}</span>
      <span data-lang="en">{post.data.titleEn ?? post.data.title}</span>
    </h1>
    <p class="text-xs text-[hsl(var(--muted-foreground))] font-mono mb-6">
      {post.data.date}
    </p>
    {post.data.tags && post.data.tags.length > 0 && (
      <TagPills tags={post.data.tags} tagsEn={post.data.tagsEn} class="mb-6" />
    )}
    {!post.data.bilingual && (
      <p data-lang="en" class="mb-6 rounded-md border border-[hsl(var(--border))] bg-[hsl(var(--muted))/45] px-3 py-2 text-xs text-[hsl(var(--muted-foreground))]">
        This essay is currently available in Chinese.
      </p>
    )}
    {sections.length >= 3 && (
      <nav aria-label="文章快捷跳转" class="article-toc">
        <details open>
          <summary>
            <span data-lang="zh">快捷跳转</span>
            <span data-lang="en">On this page</span>
          </summary>
          <ul>
            {sections.map(section => (
              <li data-depth={section.depth} style={`--toc-indent: ${(section.depth - 1) * 0.75}rem`}>
                <a href={`#${section.slug}`}>{section.text}</a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    )}
    <article class="blog-content prose prose-sm prose-neutral dark:prose-invert max-w-none prose-headings:font-medium prose-headings:tracking-tight prose-p:leading-relaxed prose-p:text-[hsl(var(--muted-foreground))] prose-code:font-mono prose-code:text-xs prose-a:underline prose-a:underline-offset-2 prose-a:decoration-[hsl(var(--muted-foreground))/30] hover:prose-a:decoration-[hsl(var(--foreground))]">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .article-toc {
    margin-bottom: 2rem;
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    font-size: 0.8125rem;
  }
  .article-toc summary {
    cursor: pointer;
    font-weight: 500;
  }
  .article-toc ul {
    display: grid;
    gap: 0.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .article-toc a {
    display: block;
    padding: 0.375rem 0;
    color: hsl(var(--muted-foreground));
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: transparent;
  }
  .article-toc li[data-depth='3'] {
    font-size: 0.75rem;
  }
  .article-toc li[data-depth] {
    padding-left: var(--toc-indent, 0);
  }
  .article-toc li[data-depth='1'] {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .article-toc li[data-depth='4'],
  .article-toc li[data-depth='5'],
  .article-toc li[data-depth='6'] {
    font-size: 0.6875rem;
    color: hsl(var(--muted-foreground) / 0.85);
  }
  .article-toc a:hover,
  .article-toc a:focus-visible {
    color: hsl(var(--foreground));
    text-decoration-color: currentColor;
  }
  .blog-content :global(:is(h1, h2, h3, h4, h5, h6)[id]) {
    scroll-margin-top: 6rem;
  }
</style>
