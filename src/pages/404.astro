---
import Layout from '../layouts/Layout.astro'
---

<Layout title="404 — Ureka Blog">
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-4 text-center">
    <p class="font-mono text-xs text-[hsl(var(--muted-foreground))]">404</p>
    <h1 class="mt-3 text-lg font-medium tracking-tight">
      <span data-lang="zh">页面走丢了</span>
      <span data-lang="en">Page not found</span>
    </h1>
    <p class="mt-3 max-w-sm text-sm leading-relaxed text-[hsl(var(--muted-foreground))]">
      <span data-lang="zh">你访问的页面不存在，或者已经被移动。</span>
      <span data-lang="en">The page you are looking for does not exist or has been moved.</span>
    </p>
    <a href="/" class="mt-8 inline-flex items-center rounded-md border border-[hsl(var(--border))] px-3 py-1.5 font-mono text-xs text-[hsl(var(--muted-foreground))] transition-colors hover:border-[hsl(var(--foreground))/30] hover:text-[hsl(var(--foreground))]">
      <span data-lang="zh">← 回到首页</span>
      <span data-lang="en">← Back home</span>
    </a>
  </main>
</Layout>
